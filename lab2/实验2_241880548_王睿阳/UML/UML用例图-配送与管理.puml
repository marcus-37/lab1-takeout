@startuml UML用例图-配送与管理
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam usecaseBorderColor #33507A
skinparam usecaseBackgroundColor #F7FBFF
skinparam actorBorderColor #33507A
skinparam ArrowColor #33507A
skinparam packageBorderColor #7A8CA6

actor "配送人员" as R
actor "平台管理员" as A
actor "定时任务" as SCH <<system>>

rectangle "外卖点餐与配送系统（履约与管理侧）" {
  package "履约与配送" {
    usecase "接受或拒绝配送任务" as UC15
    usecase "确认送达" as UC16
    usecase "上报配送失败" as UC17
    usecase "派单与改派" as UC18
  }
  package "平台管理" {
    usecase "审核商家入驻" as UC19
    usecase "强制关店与封禁" as UC20
    usecase "仲裁退款" as UC21
    usecase "查询操作记录" as UC22
  }
  package "定时任务" {
    usecase "超时未接单自动取消" as UC23
    usecase "未支付超时释放库存" as UC24
    usecase "退款超时自动同意" as UC25
  }
}

R --> UC15
R --> UC16
R --> UC17

A --> UC18
A --> UC19
A --> UC20
A --> UC21
A --> UC22

SCH --> UC23
SCH --> UC24
SCH --> UC25

UC17 .> UC18 : <<extend>>\n由管理员处置
UC18 .> UC15 : <<include>>

@enduml
