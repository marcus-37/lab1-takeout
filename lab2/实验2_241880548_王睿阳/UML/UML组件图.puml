@startuml UML组件图
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam componentBorderColor #33507A
skinparam componentBackgroundColor #F7FBFF
skinparam packageBorderColor #7A8CA6
skinparam ArrowColor #33507A

package "客户端层" {
  component [顾客端\n点餐与查单] as C
  component [商家端\n订单与菜品] as M
  component [骑手端\n配送任务] as R
  component [管理端\n审核与干预] as A
}

component [API 网关\n鉴权 / 限流 / 路由] as GW

package "应用服务层" {
  component [用户与权限服务] as USER
  component [商家与店铺服务] as SHOP
  component [商品与库存服务] as CAT
  component [订单服务] as ORD
  component [支付与退款服务] as PAY
  component [配送调度服务] as DISP
  component [售后与仲裁服务] as AFTER
  component [审计与通知服务] as AUDIT
}

package "基础设施层" {
  database "MySQL\n订单 / 库存 / 流水" as DB
  component [定时任务调度] as SCH
  component [对象存储\n菜品图片] as OSS
  component [消息通知] as MSG
}

C --> GW
M --> GW
R --> GW
A --> GW

GW --> USER
GW --> SHOP
GW --> CAT
GW --> ORD
GW --> PAY
GW --> DISP
GW --> AFTER
GW --> AUDIT

ORD --> CAT : 预占/释放库存
ORD --> PAY : 支付/退款
ORD --> DISP : 生成配送任务
DISP --> ORD : 回写订单状态
AFTER --> ORD : 取消订单
AFTER --> PAY : 发起退款
SHOP --> CAT : 上下架联动
ORD --> AUDIT : 记录状态变更

USER --> DB
SHOP --> DB
CAT --> DB
ORD --> DB
PAY --> DB
DISP --> DB
AFTER --> DB
AUDIT --> DB

CAT --> OSS : 图片读写
AUDIT --> MSG : 推送通知

SCH --> ORD : 超时未支付取消
SCH --> CAT : 每日库存重置
SCH --> AFTER : 退款超时自动同意

note right of ORD
  订单服务是唯一允许修改
  Order.status 的入口，
  其他服务只能通过接口回写，
  保证状态机不被绕过。
end note

@enduml
